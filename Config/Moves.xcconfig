// Moves — bundle identity and signing.
//
// This is the single source of truth for the app's identifiers. Every bundle ID,
// the App Group, and the iCloud container are derived from MOVES_BUNDLE_ID_PREFIX,
// and the targets, entitlements files, and Info.plist files all reference these
// settings instead of repeating literals. Changing the prefix here is enough to
// rebuild the whole app under a different identity.
//
// To build under your own Apple Developer account, do NOT edit this file. Copy
// Moves.local.xcconfig.example to Moves.local.xcconfig and edit that instead. It
// is gitignored, so your team ID and bundle prefix stay out of commits and out of
// pull requests sent back upstream.

// Reverse-DNS prefix that owns the app. Override this, not the derived settings.
MOVES_BUNDLE_ID_PREFIX = de.holgerkrupp

// Apple Developer team used to sign. Override in Moves.local.xcconfig.
DEVELOPMENT_TEAM = 46D3VYP253

// Derived identifiers. These must match the App ID, App Group, and iCloud
// container registered in the developer portal for MOVES_BUNDLE_ID_PREFIX.
MOVES_APP_BUNDLE_ID = $(MOVES_BUNDLE_ID_PREFIX).Moves
MOVES_APP_GROUP_ID = group.$(MOVES_APP_BUNDLE_ID)
MOVES_ICLOUD_CONTAINER_ID = iCloud.$(MOVES_APP_BUNDLE_ID)

// Xcode expands $(SETTING) in Info.plist and entitlements *values*, but not in
// dictionary *keys*, and NSUbiquitousContainers is keyed by the container ID. Run the
// Info.plist files through the C preprocessor so that one key can be a macro too.
//
// -traditional keeps cpp from treating the "//" in the plist DOCTYPE as a comment.
//
// The macro must NOT be named after a build setting used elsewhere in the plist: cpp
// runs first and would rewrite the text inside $(SETTING) as well, leaving Xcode to
// expand a setting that does not exist. Hence the distinct _KEY name.
INFOPLIST_PREPROCESS = YES
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional
INFOPLIST_PREPROCESSOR_DEFINITIONS = MOVES_ICLOUD_CONTAINER_KEY=$(MOVES_ICLOUD_CONTAINER_ID)

// Per-developer overrides. Absent by default; #include? does not warn when the
// file is missing.
#include? "Moves.local.xcconfig"
